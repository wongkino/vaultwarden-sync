# --- [Source / 來源] Vaultwarden ---
SRC_URL=https://vault-src.example.com
SRC_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SRC_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SRC_PASSWORD=your_source_master_password

# --- [Destination / 目的地] another Vaultwarden ---
DEST_URL=https://vault-dest.example.com
DEST_CLIENTID=user.yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
DEST_CLIENTSECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
DEST_PASSWORD=your_destination_master_password

# --- [Export crypto / 中間加密] password for the encrypted JSON (prefer different from master passwords) ---
# 導出 JSON 專用密碼（建議與主密碼不同）
EXPORT_PASSWORD=YourSuperSecretExportPassword123!

# --- [Notify / 通知] Apprise API (curl POST after every sync success/failure) ---
# Examples / 例如：http://apprise:8000/notify/  or  http://apprise:8000/notify/mytag
# Do not wrap the tag in []; use /notify/Vaultwarden-Sync
# 注意：tag 名稱不要加 []，例如用 /notify/Vaultwarden-Sync
APPRISE_URL=http://apprise:8000/notify/

# --- [Timezone / 時區] default Asia/Hong_Kong; cron runs daily 03:00 in this TZ ---
# 預設香港時間；Cron 每日 03:00 依此時區執行
TZ=Asia/Hong_Kong

# --- [Language / 語言] logs & Apprise: en | zh ---
# Leave unset or empty → English (default). Set LANG=zh for Traditional Chinese.
# 不填或留空 → 英文（預設）。設 LANG=zh 使用繁體中文。
# LANG=zh
